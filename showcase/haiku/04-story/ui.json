{
 "meta": {
  "genre": "story",
  "game": "Last Train to Aurora",
  "depth": "flat",
  "motion": "calm",
  "direction": "1940s night-train noir: lacquered black and cream type, a single amber lamp as the only accent; the dialogue is a dark plate on a bottom scrim with an amber speaker tab, choices are hairline rows with an amber bar on the selected one, and the objective is one serif line at top-centre."
 },
 "tokens": {
  "c": {"ink": "#0B0A08", "plate": "#16130F", "line": "#5B4A36", "text": "#EDE2C9", "dim": "#9A8C74", "accent": "#D9A441"},
  "r": {"sm": 3},
  "font": {"display": "Balthazar", "body": "Merriweather:Regular", "label": "Michroma"}
 },
 "components": {
  "Choice": {
   "params": {"num": "1", "text": "", "selected": false, "tone": "$c.text"},
   "node": {"class": "TextButton", "Size": [1, 0, 0, 60], "motion": "button", "children": [
    {"class": "Frame", "name": "Marker", "if": "{{selected}}", "Position": [0, 0, 0, 12], "Size": [0, 3, 1, -24], "BackgroundColor3": "$c.accent"},
    {"class": "TextLabel", "name": "Index", "Position": [0, 14, 0, 0], "Size": [0, 36, 1, 0], "Text": "{{num}}", "FontFace": "$font.label", "TextSize": 22, "TextColor3": "$c.dim", "TextXAlignment": "Left"},
    {"class": "TextLabel", "name": "Label", "Position": [0, 56, 0, 0], "Size": [1, -64, 1, 0], "Text": "{{text}}", "FontFace": "$font.body", "TextSize": 26, "TextColor3": "{{tone}}", "TextXAlignment": "Left"},
    {"class": "Frame", "name": "Rule", "AnchorPoint": [0, 1], "Position": [0, 0, 1, 0], "Size": [1, 0, 0, 1], "BackgroundColor3": "$c.line", "BackgroundTransparency": 0.5}
   ]}
  }
 },
 "root": {"class": "ScreenGui", "name": "StoryGui", "children": [
  {"class": "Frame", "name": "Scrim", "Position": [0, 0, 1, 0], "AnchorPoint": [0, 1], "Size": [1, 0, 0, 330],
   "gradient": {"colors": ["$c.ink", "$c.ink"], "transparency": [1, 0.25]}},

  {"class": "Frame", "name": "DialogueBox", "autoscale": "hud", "motion": "panel", "AnchorPoint": [0.5, 1], "Position": [0.5, 0, 1, -28], "Size": [0, 1240, 0, 400], "children": [
   {"class": "Frame", "name": "Plate", "Size": [1, 0, 1, 0], "BackgroundColor3": "$c.plate", "BackgroundTransparency": 0.12, "corner": "$r.sm",
    "stroke": {"color": "$c.line", "thickness": 1, "transparency": 0.2, "position": "Inner"},
    "children": [
     {"class": "Frame", "name": "SpeakerTab", "Position": [0, 40, 0, -20], "Size": [0, 340, 0, 40], "BackgroundColor3": "$c.accent", "corner": "$r.sm", "ZIndex": 2, "children": [
      {"class": "TextLabel", "name": "SpeakerName", "Size": [1, 0, 1, 0], "Text": "INSPECTOR HALE", "FontFace": "$font.label", "TextSize": 22, "TextColor3": "$c.ink"}
     ]},
     {"class": "TextLabel", "name": "DialogueLine", "Position": [0, 48, 0, 44], "Size": [1, -96, 0, 110], "TextWrapped": true, "TextXAlignment": "Left", "TextYAlignment": "Top", "LineHeight": 1.35,
      "Text": "The conductor's compartment is empty, the window wiped clean from the inside. Somebody on this train does not want Aurora reached.", "FontFace": "$font.body", "TextSize": 28, "TextColor3": "$c.text"},
     {"class": "Frame", "name": "Divider", "Position": [0, 48, 0, 166], "Size": [1, -96, 0, 1], "BackgroundColor3": "$c.line", "BackgroundTransparency": 0.4},
     {"class": "Frame", "name": "Choices", "Position": [0, 48, 0, 180], "Size": [1, -96, 0, 192], "list": {"dir": "V", "gap": 6}, "children": [
      {"use": "Choice", "name": "Choice1", "num": "1", "text": "Check the cold coffee cup on the table.", "selected": true, "tone": "$c.accent"},
      {"use": "Choice", "name": "Choice2", "num": "2", "text": "Ask the porter what he saw at Marlow.", "selected": false, "tone": "$c.text"},
      {"use": "Choice", "name": "Choice3", "num": "3", "text": "Say nothing and wait for the lights to dim.", "selected": false, "tone": "$c.text"}
     ]}
    ]}
   ]},

  {"class": "Frame", "name": "ObjectiveHud", "autoscale": "hud", "AnchorPoint": [0.5, 0], "Position": [0.5, 0, 0, 24], "Size": [0, 760, 0, 84], "children": [
   {"class": "Frame", "name": "Plate", "Size": [1, 0, 1, 0], "BackgroundColor3": "$c.ink", "BackgroundTransparency": 0.3, "corner": "$r.sm", "children": [
    {"class": "TextLabel", "name": "Kicker", "Position": [0, 24, 0, 10], "Size": [1, -48, 0, 22], "Text": "OBJECTIVE", "FontFace": "$font.label", "TextSize": 22, "TextColor3": "$c.accent", "TextXAlignment": "Left"},
    {"class": "TextLabel", "name": "ObjectiveText", "Position": [0, 24, 0, 36], "Size": [1, -48, 0, 40], "Text": "Find where the conductor went before Aurora.", "FontFace": "$font.display", "TextSize": 30, "TextColor3": "$c.text", "TextXAlignment": "Left"}
   ]}
  ]}
 ]}
}

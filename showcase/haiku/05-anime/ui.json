{
 "meta": {"genre": "anime", "game": "Spirit Blade Defenders", "depth": "soft", "motion": "snappy",
  "direction": "Spirit Blade Defenders summon altar: midnight ink panels with thin gold trim, a crimson-lit mythic blade behind the featured unit, rarity colours do the shouting, condensed Bangers titles and clean stat numbers"},
 "tokens": {
  "c": {"ink": "#0B1020", "panel": "#151C33", "panelHi": "#1F2A4A", "neutral": "#2B3760", "dim": "#8D98B8",
        "gold": "#F5C24B", "gem": "#4FC3FF", "crimson": "#E8374A",
        "mythic": "#FF3D7F", "legendary": "#F5C24B", "epic": "#A855F7", "rare": "#3B82F6", "common": "#9AA3B2"},
  "r": {"sm": 6, "md": 10, "lg": 14, "pill": 26},
  "font": {"display": "Bangers", "body": "Oswald", "bold": "Oswald:Bold"}
 },
 "components": {
  "SummonBtn": {
   "params": {"label": "SUMMON", "cost": "", "color": "$c.crimson"},
   "node": {"class": "TextButton", "Text": "", "AutoButtonColor": false, "motion": "button", "Size": [0, 200, 0, 150], "corner": "$r.md",
    "gradient": ["shade({{color}},0.6)", "shade({{color}},-0.6)"],
    "stroke": {"color": "shade({{color}},4)", "thickness": 1.5, "transparency": 0.25, "mode": "Border"},
    "children": [
     {"class": "UIShadow", "name": "Lift", "Color": "shade({{color}},-6)", "Offset": [0,0,0,8], "BlurRadius": [0,20], "Transparency": 0.6, "ZIndex": -1},
     {"class": "UIShadow", "name": "Edge", "Inset": true, "Color": "#FFFFFF", "Offset": [0,0,0,1], "Transparency": 0.4, "ZIndex": -2},
     {"class": "TextLabel", "name": "Label", "Position": [0,0,0.1,0], "Size": [1,0,0.56,0], "Text": "{{label}}", "FontFace": "$font.display", "TextSize": 40, "TextColor3": "#FFFFFF",
      "stroke": {"color": "shade({{color}},-5)", "thickness": 2}},
     {"class": "TextLabel", "name": "Cost", "Position": [0,0,0.66,0], "Size": [1,0,0.22,0], "Text": "{{cost}}", "FontFace": "$font.bold", "TextSize": 20, "TextColor3": "#FFFFFF", "TextTransparency": 0.15}
    ]}
  },
  "UnitCard": {
   "params": {"unit": "", "rarity": "", "rate": "", "color": "$c.common", "initial": "?"},
   "node": {"class": "Frame", "name": "UnitCard", "corner": "$r.sm",
    "gradient": ["shade({{color}},-3)", "$c.ink"],
    "stroke": {"color": "{{color}}", "thickness": 1.5, "transparency": 0.3, "mode": "Border"},
    "children": [
     {"class": "Frame", "name": "Portrait", "Position": [0,8,0,8], "Size": [1,-16,0,96], "corner": "$r.sm",
      "gradient": {"colors": ["{{color}}", "$c.ink"], "type": "Radial"},
      "children": [
       {"class": "TextLabel", "name": "Initial", "Size": [1,0,1,0], "Text": "{{initial}}", "FontFace": "$font.display", "TextSize": 56, "TextColor3": "#FFFFFF",
        "stroke": {"color": "shade({{color}},-4)", "thickness": 2}}
      ]},
     {"class": "TextLabel", "name": "RarityBand", "Position": [0,8,0,108], "Size": [1,-16,0,24], "BackgroundColor3": "{{color}}",
      "Text": "{{rarity}}", "FontFace": "$font.display", "TextSize": 18, "TextColor3": "$c.ink"},
     {"class": "TextLabel", "name": "UnitName", "Position": [0,10,0,140], "Size": [1,-20,0,24], "Text": "{{unit}}", "FontFace": "$font.bold", "TextSize": 20, "TextColor3": "#FFFFFF", "TextXAlignment": "Left"},
     {"class": "TextLabel", "name": "Rate", "Position": [0,10,0,164], "Size": [1,-20,0,18], "Text": "{{rate}}", "FontFace": "$font.body", "TextSize": 16, "TextColor3": "$c.dim", "TextXAlignment": "Left"}
    ]}
  }
 },
 "root": {"class": "ScreenGui", "name": "SummonGui", "ResetOnSpawn": false, "children": [
  {"class": "Frame", "name": "SummonPanel", "autoscale": "modal", "motion": "panel",
   "AnchorPoint": [0.5, 0.5], "Position": [0.5, 0, 0.5, 0], "Size": [0, 1000, 0, 660],
   "corner": "$r.lg", "gradient": ["$c.panel", "$c.ink"],
   "stroke": {"color": "$c.gold", "thickness": 1.5, "transparency": 0.55},
   "children": [
    {"class": "UIShadow", "name": "Lift", "Color": "#000000", "Offset": [0,0,0,12], "BlurRadius": [0,36], "Transparency": 0.6, "ZIndex": -1},

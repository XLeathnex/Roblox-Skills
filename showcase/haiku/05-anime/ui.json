     "TextXAlignment": "Left", "stroke": {"color": "$c.crimson", "thickness": 2}},
    {"class": "TextLabel", "name": "Subtitle", "Position": [0,28,0,68], "Size": [0,500,0,24], "Text": "SPIRIT BLADE DEFENDERS", "FontFace": "$font.bold", "TextSize": 18, "TextColor3": "$c.gold", "TextXAlignment": "Left"},

    {"class": "Frame", "name": "GemCounter", "AnchorPoint": [1,0], "Position": [1,-28,0,24], "Size": [0,220,0,48], "BackgroundColor3": "$c.panelHi", "corner": "$r.pill",
     "stroke": {"color": "$c.gem", "thickness": 1, "transparency": 0.5},
     "children": [
      {"class": "Frame", "name": "GemIcon", "AnchorPoint": [0,0.5], "Position": [0,20,0.5,0], "Size": [0,24,0,24], "Rotation": 45, "corner": 4,
       "gradient": ["shade($c.gem,2)", "shade($c.gem,-3)"]},
      {"class": "TextLabel", "name": "GemAmount", "Position": [0,56,0,0], "Size": [1,-70,1,0], "Text": "12,450", "FontFace": "$font.bold", "TextSize": 28, "TextColor3": "#FFFFFF", "TextXAlignment": "Right"}
     ]},

    {"class": "Frame", "name": "FeaturedBanner", "Position": [0,28,0,112], "Size": [0,540,0,300], "corner": "$r.md", "ClipsDescendants": true,
     "gradient": ["$c.panelHi", "$c.ink"],
     "children": [
      {"class": "Frame", "name": "RarityGlow", "Size": [1,0,1,0], "BackgroundTransparency": 0.35, "corner": "$r.md",
       "gradient": {"colors": ["shade($c.mythic,-3)", "$c.panel"], "type": "Radial"}},
      {"class": "Frame", "name": "Portrait", "AnchorPoint": [0.5,0], "Position": [0.5,0,0,24], "Size": [0,168,0,168], "corner": "$r.md",
       "gradient": ["shade($c.mythic,1)", "shade($c.mythic,-4)"],
       "stroke": {"color": "$c.gold", "thickness": 1.5, "transparency": 0.2, "mode": "Border"},

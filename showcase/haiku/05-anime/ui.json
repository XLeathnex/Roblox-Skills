        {"class": "TextLabel", "name": "Initial", "Size": [1,0,1,0], "Text": "V", "FontFace": "$font.display", "TextSize": 120, "TextColor3": "#FFFFFF",
         "stroke": {"color": "shade($c.mythic,-6)", "thickness": 3}}
       ]},
      {"class": "TextLabel", "name": "MythicChip", "Position": [0,20,0,20], "Size": [0,120,0,30], "BackgroundColor3": "$c.mythic", "corner": "$r.sm",
       "Text": "MYTHIC", "FontFace": "$font.display", "TextSize": 22, "TextColor3": "$c.ink"},
      {"class": "TextLabel", "name": "BannerNote", "AnchorPoint": [1,0], "Position": [1,-20,0,24], "Size": [0,200,0,22], "Text": "FEATURED BANNER", "FontFace": "$font.body", "TextSize": 16, "TextColor3": "$c.dim", "TextXAlignment": "Right"},
      {"class": "TextLabel", "name": "FeaturedName", "Position": [0,0,1,-92], "Size": [1,0,0,40], "Text": "ASHEN VAEL", "FontFace": "$font.display", "TextSize": 44, "TextColor3": "#FFFFFF",
       "stroke": {"color": "shade($c.mythic,-5)", "thickness": 2}},
      {"class": "TextLabel", "name": "FeaturedSub", "Position": [0,0,1,-50], "Size": [1,0,0,24], "Text": "Spirit Blade of the Crimson Dusk", "FontFace": "$font.body", "TextSize": 18, "TextColor3": "$c.dim"}
     ]},

    {"class": "Frame", "name": "PityCounter", "Position": [0,588,0,112], "Size": [0,384,0,92], "BackgroundColor3": "$c.panelHi", "corner": "$r.md",
     "children": [
      {"class": "TextLabel", "name": "PityLabel", "Position": [0,16,0,12], "Size": [0.6,0,0,24], "Text": "PITY COUNTER", "FontFace": "$font.bold", "TextSize": 18, "TextColor3": "$c.dim", "TextXAlignment": "Left"},
      {"class": "TextLabel", "name": "PityValue", "AnchorPoint": [1,0], "Position": [1,-16,0,8], "Size": [0.4,0,0,30], "Text": "34 / 80", "FontFace": "$font.display", "TextSize": 30, "TextColor3": "$c.gold", "TextXAlignment": "Right"},
      {"class": "Frame", "name": "PityTrack", "Position": [0,16,0,48], "Size": [1,-32,0,14], "BackgroundColor3": "shade($c.panelHi,-5)", "corner": 7,
       "children": [
        {"class": "Frame", "name": "PityFill", "Size": [0.425,0,1,0], "corner": 7, "gradient": ["shade($c.mythic,2)", "shade($c.mythic,-2)"]}
       ]},
      {"class": "TextLabel", "name": "PityHint", "Position": [0,16,0,68], "Size": [1,-32,0,18], "Text": "46 pulls until a guaranteed Mythic", "FontFace": "$font.body", "TextSize": 16, "TextColor3": "$c.dim", "TextXAlignment": "Left"}
     ]},

    {"class": "TextLabel", "name": "RateNote", "Position": [0,588,0,224], "Size": [0,384,0,26], "Text": "Mythic 1.5%  |  Legendary 4%", "FontFace": "$font.body", "TextSize": 16, "TextColor3": "$c.dim", "TextXAlignment": "Left"},
    {"use": "SummonBtn", "name": "Summon1x", "Position": [0,588,0,262], "Size": [0,172,0,150], "label": "SUMMON x1", "cost": "150 gems", "color": "$c.neutral"},
    {"use": "SummonBtn", "name": "Summon10x", "Position": [0,772,0,262], "Size": [0,200,0,150], "label": "SUMMON x10", "cost": "1,500 gems", "color": "$c.crimson"},

    {"class": "TextLabel", "name": "PossibleUnitsLabel", "Position": [0,28,0,424], "Size": [0,400,0,22], "Text": "POSSIBLE UNITS", "FontFace": "$font.bold", "TextSize": 18, "TextColor3": "$c.dim", "TextXAlignment": "Left"},
    {"class": "Frame", "name": "PossibleUnitsRow", "Position": [0,28,0,452], "Size": [1,-56,0,184], "list": {"dir": "H", "gap": 12},
     "children": [
      {"use": "UnitCard", "name": "Card_Vael", "Size": [0,176,0,184], "unit": "Ashen Vael", "rarity": "MYTHIC", "rate": "1.5% rate", "color": "$c.mythic", "initial": "V"},
      {"use": "UnitCard", "name": "Card_Sera", "Size": [0,176,0,184], "unit": "Sera Dawnlight", "rarity": "LEGENDARY", "rate": "4% rate", "color": "$c.legendary", "initial": "S"},
      {"use": "UnitCard", "name": "Card_Kenjiro", "Size": [0,176,0,184], "unit": "Kenjiro Stormfang", "rarity": "EPIC", "rate": "12% rate", "color": "$c.epic", "initial": "K"},
      {"use": "UnitCard", "name": "Card_Mira", "Size": [0,176,0,184], "unit": "Mira Tidewhisper", "rarity": "RARE", "rate": "30% rate", "color": "$c.rare", "initial": "M"},
      {"use": "UnitCard", "name": "Card_Pell", "Size": [0,176,0,184], "unit": "Pell Ironhand", "rarity": "COMMON", "rate": "52.5% rate", "color": "$c.common", "initial": "P"}
     ]}
   ]}
 ]}
}

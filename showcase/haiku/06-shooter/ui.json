{
 "meta": {
  "genre": "shooter",
  "game": "Neon Strike",
  "depth": "flat",
  "motion": "snappy",
  "direction": "Neon Strike: a dark night arena lit by blue and red neon, so cut-corner black glass plates carry a thin team-coloured edge, Oswald numerals are the loudest thing on screen, Jura caps label everything else, and one 16px chamfer angle runs through every plate so the HUD reads as one tactical system."
 },
 "tokens": {
  "c": {"plate": "#0B1220", "track": "#1C2638", "text": "#F2F6FF", "dim": "#8793A8", "blue": "#2FA8FF", "red": "#FF3D5A", "armor": "#7CFFD0"},
  "r": {"sm": 3},
  "font": {"display": "Oswald:Bold", "body": "Jura:Medium"}
 },
 "components": {
  "KillRow": {
   "params": {"killer": "", "weapon": "", "victim": "", "killerColor": "$c.blue", "victimColor": "$c.red"},
   "node": {"class": "Frame", "Size": [1, 0, 0, 40], "BackgroundColor3": "$c.plate", "BackgroundTransparency": 0.35, "corner": "$r.sm",
    "children": [
     {"class": "TextLabel", "name": "Killer", "Size": [0.42, -12, 1, 0], "Text": "{{killer}}", "FontFace": "$font.body", "TextSize": 22, "TextColor3": "{{killerColor}}", "TextXAlignment": "Right"},
     {"class": "TextLabel", "name": "Weapon", "Position": [0.42, 0, 0, 0], "Size": [0.16, 0, 1, 0], "Text": "{{weapon}}", "FontFace": "$font.body", "TextSize": 22, "TextColor3": "$c.dim", "TextXAlignment": "Center"},
     {"class": "TextLabel", "name": "Victim", "Position": [0.58, 12, 0, 0], "Size": [0.42, -12, 1, 0], "Text": "{{victim}}", "FontFace": "$font.body", "TextSize": 22, "TextColor3": "{{victimColor}}", "TextXAlignment": "Left"}
    ]}
  }
 },

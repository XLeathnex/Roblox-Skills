{
 "meta": {
  "genre": "simulator",
  "game": "Bubble Reef",
  "depth": "chunky",
  "motion": "bouncy",
  "direction": "Bubble Reef: sea-glass panel with deep teal outlines, coral HATCH buttons, gold coins and lilac pearls as the two currencies, egg tints as the rarity ladder, a tilted teal ribbon title and bubbly type."
 },
 "tokens": {
  "c": {
   "panel": "#CFF3EC",
   "line": "#0E4A5C",
   "ink": "#0B3B4F",
   "brand": "#FF7A5C",
   "close": "#E0475B",
   "sea": "#1FB5AA",
   "coin": "#FFC533",
   "coinText": "#FFE07A",
   "pearl": "#E6DDFF",
   "pearlText": "#F4EEFF",
   "shell": "#FFB3C7",
   "kelp": "#7BE08A",
   "coral": "#FF9E6B",
   "clam": "#E8E4FF",
   "abyss": "#4C7DFF",
   "myth": "#B68CFF"
  },
  "r": {"md": 14, "lg": 20, "xl": 28, "pill": [0.5, 0]},
  "font": {"display": "FredokaOne", "body": "Nunito:Bold"}
 },
 "components": {
  "Btn": {
   "params": {"text": "HATCH", "color": "$c.brand"},
   "node": {
    "class": "TextButton", "Size": [0, 200, 0, 60], "motion": "button", "corner": "$r.md",
    "gradient": ["shade({{color}},1.2)", "{{color}}", "shade({{color}},-0.8)"],
    "stroke": {"color": "$c.line", "thickness": 3, "mode": "Border"},
    "children": [
     {"class": "UIShadow", "name": "LipEdge", "Color": "$c.line", "Offset": [0,0,0,6], "Spread": [0,3,0,3], "ZIndex": -2},
     {"class": "UIShadow", "name": "Lip", "Color": "shade({{color}},-3)", "Offset": [0,0,0,6], "ZIndex": -1},
     {"class": "UIShadow", "name": "TopLight", "Inset": true, "Color": "#FFFFFF", "Offset": [0,0,0,3], "Transparency": 0.5, "ZIndex": -3},
     {"class": "UIShadow", "name": "BottomShade", "Inset": true, "Color": "shade({{color}},-3)", "Offset": [0,0,0,-4], "Transparency": 0.45, "ZIndex": -4},
     {"class": "TextLabel", "name": "Label", "Size": [1,0,1,0], "Text": "{{text}}", "FontFace": "$font.display", "TextSize": 26, "TextColor3": "#FFFFFF",
      "stroke": {"color": "$c.line", "thickness": 2.5},
      "children": [{"class": "UIShadow", "Mode": "Text", "Color": "$c.line", "Offset": [0,0,0,3]}]}
    ]
   }
  },
  "Chip": {
   "params": {"value": "0", "valueColor": "$c.coinText", "icon": "$c.coin"},
   "node": {
    "class": "Frame", "Size": [0, 230, 0, 50], "corner": "$r.pill",
    "gradient": ["shade($c.line,1)", "shade($c.line,-1)"],
    "stroke": {"color": "shade($c.line,-2)", "thickness": 3, "mode": "Border"},
    "children": [
     {"class": "UIShadow", "name": "Lip", "Color": "shade($c.line,-4)", "Offset": [0,0,0,4], "ZIndex": -1},
     {"class": "Frame", "name": "CurrencyIcon", "AnchorPoint": [0,0.5], "Position": [0,7,0.5,0], "Size": [0,36,0,36], "corner": "$r.pill",
      "gradient": ["shade({{icon}},1.5)", "{{icon}}"],
      "stroke": {"color": "shade({{icon}},-4)", "thickness": 2, "mode": "Border"},
      "children": [{"class": "Frame", "name": "Gloss", "Position": [0.2,0,0.14,0], "Size": [0.3,0,0.26,0], "corner": "$r.pill", "BackgroundColor3": "#FFFFFF", "BackgroundTransparency": 0.5}]},
     {"class": "TextLabel", "name": "Value", "Position": [0,52,0,0], "Size": [1,-64,1,0], "Text": "{{value}}", "FontFace": "$font.display", "TextSize": 26,
      "TextColor3": "{{valueColor}}", "TextXAlignment": "Right", "stroke": {"color": "$c.line", "thickness": 2}}
    ]
   }
  },
  "EggCard": {
   "params": {"id": "Shell", "label": "Shell Egg", "color": "$c.shell", "price": "250", "priceColor": "$c.coin", "tag": ""},
   "node": {
    "class": "Frame", "name": "EggCard_{{id}}", "corner": "$r.lg",
    "gradient": ["#FFFFFF", "shade($c.panel,-1)"],
    "stroke": {"color": "$c.line", "thickness": 3, "mode": "Border"},
    "children": [
     {"class": "UIShadow", "name": "LipEdge", "Color": "$c.line", "Offset": [0,0,0,6], "Spread": [0,3,0,3], "ZIndex": -2},
     {"class": "UIShadow", "name": "Lip", "Color": "shade($c.panel,-4)", "Offset": [0,0,0,6], "ZIndex": -1},
     {"class": "Frame", "name": "Egg", "AnchorPoint": [0.5,0], "Position": [0.5,0,0,10], "Size": [0,96,0,104], "corner": [0.5,0],
      "gradient": ["shade({{color}},1.5)", "{{color}}", "shade({{color}},-1.5)"],
      "stroke": {"color": "shade({{color}},-4)", "thickness": 3, "mode": "Border"},
      "children": [{"class": "Frame", "name": "Shine", "Position": [0.2,0,0.14,0], "Size": [0.2,0,0.24,0], "corner": [0.5,0], "BackgroundColor3": "#FFFFFF", "BackgroundTransparency": 0.45, "Rotation": -20}]},
     {"class": "TextLabel", "name": "Name", "Position": [0,8,0,116], "Size": [1,-16,0,28], "Text": "{{label}}", "FontFace": "$font.display", "TextSize": 24, "TextColor3": "$c.ink"},
     {"class": "Frame", "name": "Price", "Position": [0,8,0,146], "Size": [1,-16,0,24], "list": {"dir": "H", "gap": 6, "align": "Center", "valign": "Center"},
      "children": [
       {"class": "Frame", "name": "CurrencyIcon", "Size": [0,22,0,22], "corner": "$r.pill", "gradient": ["shade({{priceColor}},1.5)", "{{priceColor}}"], "stroke": {"color": "shade({{priceColor}},-4)", "thickness": 2, "mode": "Border"}},
       {"class": "TextLabel", "name": "Cost", "Size": [0,80,1,0], "Text": "{{price}}", "FontFace": "$font.body", "TextSize": 22, "TextColor3": "$c.ink", "TextXAlignment": "Left"}
      ]},
     {"if": "{{tag}}", "class": "Frame", "name": "Tag", "AnchorPoint": [1,0], "Position": [1,-8,0,10], "Size": [0,96,0,26], "Rotation": 8, "corner": "$r.pill",
      "gradient": ["shade($c.sea,1)", "shade($c.sea,-1)"], "stroke": {"color": "$c.line", "thickness": 2, "mode": "Border"},
      "children": [{"class": "TextLabel", "name": "TagLabel", "Size": [1,0,1,0], "Text": "{{tag}}", "FontFace": "$font.body", "TextSize": 16, "TextColor3": "#FFFFFF"}]},
     {"use": "Btn", "name": "HatchButton", "text": "HATCH", "color": "$c.brand", "AnchorPoint": [0,1], "Position": [0,12,1,-12], "Size": [1,-24,0,36]}
    ]
   }
  }
 },
 "root": {"class": "ScreenGui", "name": "EggShopGui", "children": [
  {"class": "Frame", "name": "ShopPanel", "autoscale": "modal", "motion": "panel", "AnchorPoint": [0.5,0.5], "Position": [0.5,0,0.5,0], "Size": [0,900,0,600],
   "corner": "$r.xl", "gradient": ["shade($c.panel,0.6)", "shade($c.panel,-1)"],
   "stroke": {"color": "$c.line", "thickness": 4, "mode": "Border"},
   "children": [
    {"class": "UIShadow", "name": "LipEdge", "Color": "$c.line", "Offset": [0,0,0,10], "Spread": [0,4,0,4], "ZIndex": -2},
    {"class": "UIShadow", "name": "Lip", "Color": "shade($c.panel,-4)", "Offset": [0,0,0,10], "ZIndex": -1},
    {"class": "Frame", "name": "BalanceRow", "Position": [0,28,0,64], "Size": [1,-56,0,50], "list": {"dir": "H", "gap": 12, "align": "Left", "valign": "Center"},
     "children": [
      {"use": "Chip", "name": "CoinsChip", "value": "12,480", "valueColor": "$c.coinText", "icon": "$c.coin"},
      {"use": "Chip", "name": "PearlsChip", "value": "384", "valueColor": "$c.pearlText", "icon": "$c.pearl"}
     ]},
    {"class": "Frame", "name": "EggGrid", "Position": [0,28,0,126], "Size": [1,-56,0,456], "grid": {"cell": [0,260,0,220], "gap": 16, "max": 3},
     "children": [
      {"use": "EggCard", "id": "Shell", "label": "Shell Egg", "color": "$c.shell", "price": "250", "priceColor": "$c.coin"},
      {"use": "EggCard", "id": "Kelp", "label": "Kelp Egg", "color": "$c.kelp", "price": "1.5K", "priceColor": "$c.coin", "tag": "POPULAR"},
      {"use": "EggCard", "id": "Coral", "label": "Coral Egg", "color": "$c.coral", "price": "12K", "priceColor": "$c.coin"},
      {"use": "EggCard", "id": "Clam", "label": "Clam Egg", "color": "$c.clam", "price": "40", "priceColor": "$c.pearl"},
      {"use": "EggCard", "id": "Abyss", "label": "Abyss Egg", "color": "$c.abyss", "price": "150", "priceColor": "$c.pearl"},
      {"use": "EggCard", "id": "Myth", "label": "Mythic Tide Egg", "color": "$c.myth", "price": "500", "priceColor": "$c.pearl", "tag": "BEST"}
     ]},
    {"class": "Frame", "name": "TitleRibbon", "AnchorPoint": [0.5,0], "Position": [0.5,0,0,-30], "Size": [0,340,0,64], "Rotation": -3, "corner": "$r.md",
     "gradient": ["shade($c.sea,1.2)", "shade($c.sea,-1)"],
     "stroke": {"color": "$c.line", "thickness": 4, "mode": "Border"},
     "children": [
      {"class": "UIShadow", "name": "Lip", "Color": "shade($c.sea,-4)", "Offset": [0,0,0,5], "ZIndex": -1},
      {"class": "TextLabel", "name": "Title", "Size": [1,0,1,0], "Text": "EGG SHOP", "FontFace": "$font.display", "TextSize": 38, "TextColor3": "#FFFFFF",
       "stroke": {"color": "$c.line", "thickness": 3}}
     ]},
    {"use": "Btn", "name": "CloseButton", "text": "X", "color": "$c.close", "AnchorPoint": [0.5,0.5], "Position": [1,-4,0,4], "Size": [0,56,0,56], "closes": "ShopPanel"}
   ]}
 ]}
}

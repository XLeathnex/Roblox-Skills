{
 "meta": {
  "genre": "obby",
  "game": "Tower of Sweets",
  "depth": "chunky",
  "motion": "bouncy",
  "direction": "Tower of Sweets: hard-candy chips with chocolate outlines instead of black, strawberry for progress, cream wafer for info, mint means skip/go, butterscotch coins, peppermint-stripe ribbon for every stage banner, bubbly FredokaOne numbers"
 },
 "tokens": {
  "c": {
   "line": "#4A2416",
   "berry": "#FF5C8A",
   "mint": "#3FD9A0",
   "butter": "#FFC531",
   "cream": "#FFF1DC",
   "white": "#FFFFFF"
  },
  "r": {"sm": 12, "md": 20, "lg": 26},
  "font": {"display": "FredokaOne"}
 },
 "components": {
  "Candy": {
   "params": {"color": "$c.berry"},
   "node": {"class": "Frame", "corner": "$r.md",
    "gradient": ["shade({{color}},1.2)", "{{color}}", "shade({{color}},-0.8)"],
    "stroke": {"color": "$c.line", "thickness": 3, "mode": "Border"},
    "children": [
     {"class": "UIShadow", "name": "LipEdge", "Color": "$c.line", "Offset": [0, 0, 0, 6], "Spread": [0, 3, 0, 3], "ZIndex": -2},
     {"class": "UIShadow", "name": "Lip", "Color": "shade({{color}},-3)", "Offset": [0, 0, 0, 6], "ZIndex": -1},
     {"class": "UIShadow", "name": "TopLight", "Inset": true, "Color": "#FFFFFF", "Offset": [0, 0, 0, 3], "Transparency": 0.5, "ZIndex": -3},
     {"class": "UIShadow", "name": "BottomShade", "Inset": true, "Color": "shade({{color}},-3)", "Offset": [0, 0, 0, -4], "Transparency": 0.45, "ZIndex": -4}
    ]}
  },
  "CandyButton": {
   "params": {"color": "$c.mint"},
   "node": {"class": "TextButton", "motion": "button", "corner": "$r.md",
    "gradient": ["shade({{color}},1.2)", "{{color}}", "shade({{color}},-0.8)"],
    "stroke": {"color": "$c.line", "thickness": 3, "mode": "Border"},
    "children": [
     {"class": "UIShadow", "name": "LipEdge", "Color": "$c.line", "Offset": [0, 0, 0, 7], "Spread": [0, 3, 0, 3], "ZIndex": -2},
     {"class": "UIShadow", "name": "Lip", "Color": "shade({{color}},-3)", "Offset": [0, 0, 0, 7], "ZIndex": -1},
     {"class": "UIShadow", "name": "TopLight", "Inset": true, "Color": "#FFFFFF", "Offset": [0, 0, 0, 3], "Transparency": 0.5, "ZIndex": -3},
     {"class": "UIShadow", "name": "BottomShade", "Inset": true, "Color": "shade({{color}},-3)", "Offset": [0, 0, 0, -4], "Transparency": 0.45, "ZIndex": -4}
    ]}
  },
  "Title": {
   "params": {"text": ""},
   "node": {"class": "TextLabel", "Text": "{{text}}", "FontFace": "$font.display", "TextSize": 30, "TextColor3": "$c.white",
    "stroke": {"color": "$c.line", "thickness": 2.5},
    "children": [{"class": "UIShadow", "Mode": "Text", "Color": "$c.line", "Offset": [0, 0, 0, 3]}]}
  },
  "Ink": {
   "params": {"text": ""},
   "node": {"class": "TextLabel", "Text": "{{text}}", "FontFace": "$font.display", "TextSize": 30, "TextColor3": "$c.line"}
  }
 },
 "root": {"class": "ScreenGui", "name": "ObbyHud", "ResetOnSpawn": false, "children": [

  {"class": "Frame", "name": "StageGroup", "autoscale": "hud", "AnchorPoint": [0.5, 0], "Position": [0.5, 0, 0, 12], "Size": [0, 270, 0, 150], "children": [
   {"use": "Candy", "name": "StageChip", "color": "$c.berry", "AnchorPoint": [0.5, 0], "Position": [0.5, 0, 0, 0], "Size": [0, 270, 0, 76], "children": [
    {"class": "ImageLabel", "name": "FlagIcon", "Image": "asset:flag", "ScaleType": "Fit", "AnchorPoint": [0, 0.5], "Position": [0, 10, 0.5, -2], "Size": [0, 56, 0, 56]},
    {"use": "Title", "name": "StageText", "RichText": true, "text": "STAGE <font size=\"44\">12</font><font size=\"24\" transparency=\"0.25\"> / 50</font>", "TextSize": 26, "TextXAlignment": "Left", "Position": [0, 74, 0, 0], "Size": [1, -86, 1, -4]}
   ]},
   {"use": "Candy", "name": "TimerPill", "color": "$c.cream", "corner": "$r.sm", "AnchorPoint": [0.5, 0], "Position": [0.5, 0, 0, 92], "Size": [0, 196, 0, 52], "children": [
    {"class": "ImageLabel", "name": "ClockIcon", "Image": "asset:clock", "ScaleType": "Fit", "AnchorPoint": [0, 0.5], "Position": [0, 8, 0.5, -1], "Size": [0, 40, 0, 40]},
    {"use": "Ink", "name": "TimerText", "text": "04:32.18", "TextSize": 28, "TextXAlignment": "Left", "Position": [0, 56, 0, 0], "Size": [1, -64, 1, -2]}
   ]}
  ]},

  {"class": "Frame", "name": "RightGroup", "autoscale": "hud", "AnchorPoint": [1, 0], "Position": [1, -16, 0, 72], "Size": [0, 230, 0, 176], "children": [
   {"use": "Candy", "name": "CoinChip", "color": "$c.cream", "AnchorPoint": [1, 0], "Position": [1, 0, 0, 4], "Size": [0, 196, 0, 58], "children": [
    {"use": "Ink", "name": "CoinText", "text": "1,250", "TextSize": 32, "TextXAlignment": "Right", "Position": [0, 44, 0, 0], "Size": [1, -60, 1, -2]}
   ]},
   {"class": "ImageLabel", "name": "CoinIcon", "Image": "asset:coin", "ScaleType": "Fit", "AnchorPoint": [0, 0.5], "Position": [0, 4, 0, 32], "Size": [0, 72, 0, 72], "ZIndex": 3},
   {"use": "CandyButton", "name": "SkipButton", "color": "$c.mint", "AnchorPoint": [1, 0], "Position": [1, 0, 0, 84], "Size": [0, 214, 0, 76], "children": [
    {"class": "ImageLabel", "name": "ArrowIcon", "Image": "asset:arrow", "ScaleType": "Fit", "AnchorPoint": [0, 0.5], "Position": [0, 10, 0.5, -2], "Size": [0, 48, 0, 48]},
    {"use": "Title", "name": "SkipText", "text": "SKIP STAGE", "TextSize": 28, "TextXAlignment": "Left", "Position": [0, 64, 0, 0], "Size": [1, -70, 1, -4]},
    {"use": "Candy", "name": "PriceTag", "color": "$c.butter", "corner": "$r.sm", "AnchorPoint": [1, 0.5], "Position": [1, 10, 0, 0], "Size": [0, 70, 0, 30], "Rotation": 4, "children": [
     {"use": "Ink", "name": "PriceText", "text": "R$ 15", "TextSize": 20, "Size": [1, 0, 1, -2]}
    ]}
   ]}
  ]},

  {"class": "Frame", "name": "StageCompleteBanner", "autoscale": "hud", "motion": "panel", "startHidden": true, "AnchorPoint": [0.5, 0.5], "Position": [0.5, 0, 0.32, 0], "Size": [0, 780, 0, 200], "children": [
   {"class": "ImageLabel", "name": "Rays", "Image": "asset:sunburst", "ImageColor3": "$c.butter", "ImageTransparency": 0.55, "AnchorPoint": [0.5, 0.5], "Position": [0.5, 0, 0.5, 0], "Size": [0, 440, 0, 440], "ZIndex": 0},
   {"class": "ImageLabel", "name": "RibbonTails", "Image": "asset:ribbon", "ScaleType": "Slice", "SliceCenter": [29, 47, 163, 49], "ImageColor3": "shade($c.berry,-1.5)", "AnchorPoint": [0.5, 0.5], "Position": [0.5, 0, 0.5, 14], "Size": [0, 780, 0, 104], "ZIndex": 1},
   {"use": "Candy", "name": "BannerPlate", "color": "$c.berry", "corner": "$r.lg", "AnchorPoint": [0.5, 0.5], "Position": [0.5, 0, 0.5, 0], "Size": [0, 600, 0, 120], "ZIndex": 2, "children": [
    {"class": "ImageLabel", "name": "PeppermintStripes", "Image": "asset:stripes", "ScaleType": "Tile", "TileSize": [0, 96, 0, 96], "ImageColor3": "$c.white", "ImageTransparency": 0.86, "corner": "$r.lg", "Size": [1, 0, 1, 0], "ZIndex": 2},
    {"use": "Title", "name": "BannerText", "text": "STAGE COMPLETE!", "TextSize": 60, "Size": [1, 0, 1, -6], "ZIndex": 3}
   ]},
   {"use": "Candy", "name": "StageTag", "color": "$c.mint", "corner": "$r.sm", "AnchorPoint": [0.5, 0.5], "Position": [0.5, 0, 0.5, -66], "Size": [0, 170, 0, 42], "Rotation": -3, "ZIndex": 4, "children": [
    {"use": "Title", "name": "StageTagText", "text": "STAGE 12", "TextSize": 26, "Size": [1, 0, 1, -2], "ZIndex": 4}
   ]},
   {"use": "Candy", "name": "RewardPill", "color": "$c.cream", "corner": "$r.sm", "AnchorPoint": [0.5, 0.5], "Position": [0.5, 0, 0.5, 70], "Size": [0, 150, 0, 46], "ZIndex": 4, "children": [
    {"class": "ImageLabel", "name": "RewardCoin", "Image": "asset:coin", "ScaleType": "Fit", "AnchorPoint": [0, 0.5], "Position": [0, 8, 0.5, -1], "Size": [0, 38, 0, 38], "ZIndex": 4},
    {"use": "Ink", "name": "RewardText", "text": "+25", "TextSize": 28, "Position": [0, 46, 0, 0], "Size": [1, -56, 1, -2], "ZIndex": 4}
   ]}
  ]}
 ]}
}

{
 "meta": {
  "genre": "story",
  "game": "Last Train to Aurora",
  "depth": "flat",
  "motion": "calm",
  "direction": "Last Train to Aurora: 1940s Pullman-car noir, cream serif caps on smoked-glass black like a sleeper-car window at midnight, thin brass-trim hairlines instead of boxes, a conductor's-ticket name tab, and aurora jade marks only the line you choose"
 },
 "tokens": {
  "c": {
   "night": "#0E0C0B",
   "cream": "#EADFC8",
   "jade": "#6FCBA8"
  },
  "r": {"sm": 2},
  "font": {
   "display": "Merriweather:Black",
   "label": "Merriweather:Bold",
   "body": "Merriweather"
  }
 },
 "components": {
  "Choice": {
   "params": {"n": "1", "text": "Choice", "ink": "shade($c.cream,-2)", "num": "shade($c.cream,-4)", "selected": ""},
   "node": {"class": "TextButton", "Size": [1, 0, 0, 56], "motion": "button", "children": [
    {"class": "Frame", "name": "HoverWash", "if": "{{selected}}", "Size": [1, 0, 1, 0], "BackgroundColor3": "$c.cream", "BackgroundTransparency": 0.94},
    {"class": "Frame", "name": "SelectBar", "if": "{{selected}}", "AnchorPoint": [0, 0.5], "Position": [0, 0, 0.5, 0], "Size": [0, 3, 0, 32], "BackgroundColor3": "$c.jade"},
    {"class": "TextLabel", "name": "Number", "Position": [0, 18, 0, 0], "Size": [0, 32, 1, 0], "Text": "{{n}}", "FontFace": "$font.display", "TextSize": 22, "TextColor3": "{{num}}", "TextXAlignment": "Left"},
    {"class": "TextLabel", "name": "Label", "Position": [0, 56, 0, 0], "Size": [1, -72, 1, 0], "Text": "{{text}}", "FontFace": "$font.body", "TextSize": 26, "TextColor3": "{{ink}}", "TextXAlignment": "Left"},
    {"class": "Frame", "name": "Rule", "AnchorPoint": [0, 1], "Position": [0, 0, 1, 0], "Size": [1, 0, 0, 1], "BackgroundColor3": "$c.cream", "BackgroundTransparency": 0.88}
   ]}
  },
  "Hairline": {
   "params": {"x": 0},
   "node": {"class": "Frame", "Size": [0, 56, 0, 1], "BackgroundColor3": "$c.cream", "BackgroundTransparency": 0.6}
  }
 },
 "root": {"class": "ScreenGui", "name": "StoryGui", "children": [
  {"class": "Frame", "name": "BottomScrim", "AnchorPoint": [0, 1], "Position": [0, 0, 1, 0], "Size": [1, 0, 0.55, 0],
   "gradient": {"colors": ["$c.night", "$c.night"], "rotation": 90, "transparency": [1, 0.15]}},

  {"class": "Frame", "name": "Objective", "autoscale": "hud", "AnchorPoint": [0.5, 0], "Position": [0.5, 0, 0, 16], "Size": [0, 600, 0, 84],
   "gradient": {"colors": ["$c.night", "$c.night"], "rotation": 0, "transparency": [1, 0.35, 0.35, 1]},
   "children": [
    {"class": "Frame", "name": "Header", "Position": [0, 0, 0, 8], "Size": [1, 0, 0, 26],
     "list": {"dir": "H", "gap": 14, "align": "Center", "valign": "Center"},
     "children": [
      {"use": "Hairline", "name": "RuleLeft", "LayoutOrder": 1},
      {"class": "TextLabel", "name": "ObjectiveTitle", "LayoutOrder": 2, "Size": [0, 150, 1, 0], "Text": "OBJECTIVE", "FontFace": "$font.label", "TextSize": 20, "TextColor3": "$c.jade"},
      {"use": "Hairline", "name": "RuleRight", "LayoutOrder": 3}
     ]},
    {"class": "TextLabel", "name": "ObjectiveText", "Position": [0, 16, 0, 38], "Size": [1, -32, 0, 36], "Text": "Find out who boarded at Harlow Junction", "FontFace": "$font.body", "TextSize": 26, "TextColor3": "$c.cream"}
   ]},

  {"class": "Frame", "name": "DialogueBox", "autoscale": "hud", "AnchorPoint": [0.5, 1], "Position": [0.5, 0, 1, -24], "Size": [0, 920, 0, 336],
   "BackgroundColor3": "$c.night", "BackgroundTransparency": 0.22, "corner": "$r.sm",
   "stroke": {"color": "$c.cream", "thickness": 1, "transparency": 0.82},
   "children": [
    {"class": "Frame", "name": "NameTab", "Position": [0, 28, 0, -18], "Size": [0, 0, 0, 36], "AutomaticSize": "X",
     "BackgroundColor3": "$c.jade", "corner": "$r.sm", "padding": [0, 16],
     "children": [
      {"class": "TextLabel", "name": "SpeakerName", "Size": [0, 0, 1, 0], "AutomaticSize": "X", "Text": "CONDUCTOR REILLY", "FontFace": "$font.display", "TextSize": 20, "TextColor3": "$c.night"}
     ]},
    {"class": "TextLabel", "name": "Body", "Position": [0, 32, 0, 38], "Size": [1, -64, 0, 76], "TextWrapped": true, "LineHeight": 1.2,
     "TextXAlignment": "Left", "TextYAlignment": "Top",
     "Text": "She paid cash, detective. Kept her gloves on the whole way from Chicago, and never once took them off.",
     "FontFace": "$font.body", "TextSize": 28, "TextColor3": "$c.cream"},
    {"class": "Frame", "name": "Choices", "Position": [0, 16, 0, 136], "Size": [1, -32, 0, 176],
     "list": {"dir": "V", "gap": 4},
     "children": [
      {"use": "Choice", "name": "Choice1", "LayoutOrder": 1, "n": "1", "text": "Who else saw her board?", "ink": "$c.cream", "num": "$c.jade", "selected": "true"},
      {"use": "Choice", "name": "Choice2", "LayoutOrder": 2, "n": "2", "text": "Show him the torn ticket stub."},
      {"use": "Choice", "name": "Choice3", "LayoutOrder": 3, "n": "3", "text": "Say nothing. Let him keep talking."}
     ]}
   ]}
 ]}
}
